#version 450
layout(local_size_x = 256) in;
layout(set=0,binding=0,std430) readonly buffer Input { float rgb[]; };
layout(set=0,binding=1,std430) readonly buffer SensorMask { uint mask[]; };
layout(set=0,binding=2,std430) readonly buffer Count { uint pixels; };
layout(set=0,binding=3,std430) readonly buffer Gain { float gain; };
layout(set=0,binding=4,std430) writeonly buffer Output { float result[]; };
void main() {
    uint i = gl_GlobalInvocationID.y*(gl_NumWorkGroups.x*gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
    if (i >= pixels) return;
    float scale = (mask[i/32u] & (1u << (i%32u))) != 0u ? gain : 1.0;
    for (uint c=0u; c<3u; ++c) result[3u*i+c] = rgb[3u*i+c]*scale;
}
