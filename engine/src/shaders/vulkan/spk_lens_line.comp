#version 450

// spk_lens_line.comp -- one directional gather of the lens's field aberrations
// (API-SPEC §21.6, macOS 2.x, ported from src/shaders/lens.metal).
//
// Mode 0 gathers along e_t (field curvature + tangential astigmatism + the
// comet's spread), mode 1 along e_r (curvature + radial astigmatism + the
// comet), on the mip level whose texel is <= sigma / 4 and blended with the next
// coarser one by the fraction (trilinear), each level's own variance taken out
// of the Gaussian so the second moments are the formula's. Mode 1 also scales by
// the comet's Jacobian, so a point keeps its energy where the shift varies over
// the field.
//
// levels 0..4 at bindings 0..4; lv: {I0, LH, LW} x 5 (signed); lp: {pcx, pcy,
// inv_hd, h0, p, sfc, sast, coma}; meta: {H, W, row0, mode, lmax}
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer L0 { float value[]; } l0;
layout(set = 0, binding = 1, std430) readonly buffer L1 { float value[]; } l1;
layout(set = 0, binding = 2, std430) readonly buffer L2 { float value[]; } l2;
layout(set = 0, binding = 3, std430) readonly buffer L3 { float value[]; } l3;
layout(set = 0, binding = 4, std430) readonly buffer L4 { float value[]; } l4;
layout(set = 0, binding = 5, std430) readonly buffer Lv { int value[]; } lv;
layout(set = 0, binding = 6, std430) readonly buffer Lp { float value[]; } lp;
layout(set = 0, binding = 7, std430) readonly buffer Meta { uint value[]; } meta;
layout(set = 0, binding = 8, std430) writeonly buffer Out { float value[]; } out_data;

uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

vec3 ld3(uint s) { return vec3(l0.value[3u * s], l0.value[3u * s + 1u], l0.value[3u * s + 2u]); }

// Bilinear on a plane-anchored grid of factor T, rows stored [I0, I0 + LH).
vec3 level_sample_of(int l, int I0, int LH, int LW, float T, float X, float Y) {
    float u = (X + 0.5) / T - 0.5, v = (Y + 0.5) / T - 0.5;
    float uf = floor(u), vf = floor(v);
    float fx = u - uf, fy = v - vf;
    int j0 = clamp(int(uf), 0, LW - 1), j1 = clamp(int(uf) + 1, 0, LW - 1);
    int i0 = clamp(int(vf) - I0, 0, LH - 1), i1 = clamp(int(vf) + 1 - I0, 0, LH - 1);
    uint s00 = uint(i0 * LW + j0), s01 = uint(i0 * LW + j1);
    uint s10 = uint(i1 * LW + j0), s11 = uint(i1 * LW + j1);
    vec3 v00, v01, v10, v11;
    if (l == 0) {
        v00 = vec3(l0.value[3u * s00], l0.value[3u * s00 + 1u], l0.value[3u * s00 + 2u]);
        v01 = vec3(l0.value[3u * s01], l0.value[3u * s01 + 1u], l0.value[3u * s01 + 2u]);
        v10 = vec3(l0.value[3u * s10], l0.value[3u * s10 + 1u], l0.value[3u * s10 + 2u]);
        v11 = vec3(l0.value[3u * s11], l0.value[3u * s11 + 1u], l0.value[3u * s11 + 2u]);
    } else if (l == 1) {
        v00 = vec3(l1.value[3u * s00], l1.value[3u * s00 + 1u], l1.value[3u * s00 + 2u]);
        v01 = vec3(l1.value[3u * s01], l1.value[3u * s01 + 1u], l1.value[3u * s01 + 2u]);
        v10 = vec3(l1.value[3u * s10], l1.value[3u * s10 + 1u], l1.value[3u * s10 + 2u]);
        v11 = vec3(l1.value[3u * s11], l1.value[3u * s11 + 1u], l1.value[3u * s11 + 2u]);
    } else if (l == 2) {
        v00 = vec3(l2.value[3u * s00], l2.value[3u * s00 + 1u], l2.value[3u * s00 + 2u]);
        v01 = vec3(l2.value[3u * s01], l2.value[3u * s01 + 1u], l2.value[3u * s01 + 2u]);
        v10 = vec3(l2.value[3u * s10], l2.value[3u * s10 + 1u], l2.value[3u * s10 + 2u]);
        v11 = vec3(l2.value[3u * s11], l2.value[3u * s11 + 1u], l2.value[3u * s11 + 2u]);
    } else if (l == 3) {
        v00 = vec3(l3.value[3u * s00], l3.value[3u * s00 + 1u], l3.value[3u * s00 + 2u]);
        v01 = vec3(l3.value[3u * s01], l3.value[3u * s01 + 1u], l3.value[3u * s01 + 2u]);
        v10 = vec3(l3.value[3u * s10], l3.value[3u * s10 + 1u], l3.value[3u * s10 + 2u]);
        v11 = vec3(l3.value[3u * s11], l3.value[3u * s11 + 1u], l3.value[3u * s11 + 2u]);
    } else {
        v00 = vec3(l4.value[3u * s00], l4.value[3u * s00 + 1u], l4.value[3u * s00 + 2u]);
        v01 = vec3(l4.value[3u * s01], l4.value[3u * s01 + 1u], l4.value[3u * s01 + 2u]);
        v10 = vec3(l4.value[3u * s10], l4.value[3u * s10 + 1u], l4.value[3u * s10 + 2u]);
        v11 = vec3(l4.value[3u * s11], l4.value[3u * s11 + 1u], l4.value[3u * s11 + 2u]);
    }
    return (1.0 - fy) * ((1.0 - fx) * v00 + fx * v01) + fy * ((1.0 - fx) * v10 + fx * v11);
}

// The standard normal CDF (Abramowitz & Stegun 7.1.26 for erf, |error| < 1.5e-7).
float norm_cdf(float z) {
    float x = abs(z) * 0.70710678118654752;
    float t = 1.0 / (1.0 + 0.3275911 * x);
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t +
                      0.254829592) * t * exp(-x * x);
    return z >= 0.0 ? 0.5 * (1.0 + y) : 0.5 * (1.0 - y);
}
float norm_pdf(float z) { return exp(-0.5 * z * z); }   // unnormalised: a common factor

float knee_of(float h, float h0) {
    return h0 > 0.0 ? smoothstep(h0, min(h0 + 0.1, 1.0), h) : 1.0;
}
float g_field(float h, float h0, float pexp) {
    float u = h0 > 0.0 ? max(h - h0, 0.0) / (1.0 - h0) : h;
    return knee_of(h, h0) * pow(max(u, 0.0), pexp);
}
float g_coma(float h, float h0) {
    float u = h0 > 0.0 ? max(h - h0, 0.0) / (1.0 - h0) : h;
    return knee_of(h, h0) * u;
}

struct Field { float var_t; float var_r; float L; };
Field field_at(float h) {
    float g = g_field(h, lp.value[3], lp.value[4]);
    float sfc = lp.value[5] * g, sa = abs(lp.value[6]) * g;
    Field F;
    F.L = lp.value[7] * g_coma(h, lp.value[3]);
    // the comet's tangential spread: a 60-degree wedge, s | t uniform on
    // +-t tan 30 deg, so E[s^2] = E[t^2] / 9 = L^2 / 54 for the triangle below
    F.var_t = sfc * sfc + (lp.value[6] > 0.0 ? sa * sa : 0.0) + F.L * F.L / 54.0;
    F.var_r = sfc * sfc + (lp.value[6] < 0.0 ? sa * sa : 0.0);
    return F;
}

const float kMinSigma = 0.4;   // kMinEffectiveBlurSigma
const int kMaxTaps = 160;
const float kMinComet = 0.05;  // px: a comet shorter moves nothing a code sees
const float kTruncate = 3.5;   // the Gaussian's support, sigmas (lens.cpp kLineTruncate)

float level_variance(int l) {
    float T = float(1 << l);
    return (T * T - 1.0) / 4.0 + T * T / 6.0;   // the tents down, the bilinear back
}

struct Lod { int l0; float frac; float va, vp, q, rho; bool enabled; };
Lod lod_for(float sigma, int lmax, bool force) {
    Lod d;
    d.enabled = sigma >= kMinSigma || force;
    d.q = clamp((sigma - kMinSigma) / (2.0 - kMinSigma), 0.0, 1.0);
    d.rho = force ? 1.0 : smoothstep(kMinSigma, 4.0 * kMinSigma, sigma);
    if (!d.enabled) { d.l0 = 0; d.frac = 0.0; d.va = 0.0; d.vp = 0.0; d.rho = 0.0; return d; }
    float lam = log2(sigma / 4.0);
    if (lam <= 0.0) { d.l0 = 0; d.frac = 0.0; }
    else if (lam >= float(lmax)) { d.l0 = lmax; d.frac = 0.0; }
    else { d.l0 = int(floor(lam)); d.frac = lam - float(d.l0); }
    float T0 = float(1 << d.l0), T1 = 2.0 * T0;
    d.va = (1.0 - d.frac) * level_variance(d.l0) +
           (d.frac > 0.0 ? d.frac * level_variance(d.l0 + 1) : 0.0);
    d.vp = d.va + 0.25 * d.q * d.q * ((1.0 - d.frac) * T0 * T0 + d.frac * T1 * T1);
    return d;
}

// The radial pass's 1-D kernel at offset s: a Gaussian sigma convolved with the
// comet's triangle rho(t) ~ (1 - t / L) on [0, L]. Unnormalised.
float comet_weight(float s, float sigma, float L) {
    if (L < 1e-3) return sigma > 1e-3 ? norm_pdf(s / sigma) : (abs(s) < 0.5 ? 1.0 : 0.0);
    if (sigma < 1e-3) return (s >= 0.0 && s <= L) ? (1.0 - s / L) : 0.0;
    float b = s / sigma, a = (s - L) / sigma;
    float dP = norm_cdf(b) - norm_cdf(a);
    float dp = (norm_pdf(b) - norm_pdf(a)) * 0.39894228040143268;
    return max(dP - (s * dP + sigma * dp) / L, 0.0);
}

// The comet's mass up to s.
float comet_cdf(float s, float sigma, float L) {
    float a = (s - L) / sigma, b = s / sigma;
    float Pa = norm_cdf(a), Pb = norm_cdf(b);
    float pa = norm_pdf(a) * 0.39894228040143268, pb = norm_pdf(b) * 0.39894228040143268;
    float I0 = (b * Pb + pb) - (a * Pa + pa);
    float I1 = 0.5 * (((b * b - 1.0) * Pb + b * pb) - ((a * a - 1.0) * Pa + a * pa));
    return sigma * ((1.0 - s / L) * I0 + (sigma / L) * I1);
}
// A tap's share of the comet: its mass over the tap's own cell [s - T/2, s + T/2].
float comet_cell(float s, float sigma, float L, float T) {
    sigma = max(sigma, 0.02 * T);
    return max(comet_cdf(s + 0.5 * T, sigma, L) - comet_cdf(s - 0.5 * T, sigma, L), 0.0);
}

void main() {
    uint i = spk_global_index();
    uint H = meta.value[0], W = meta.value[1], row0 = meta.value[2], mode = meta.value[3];
    int lmax = int(meta.value[4]);
    if (i >= H * W) return;
    uint y = i / W, x = i % W;
    float X = float(x), Y = float(y + row0);
    float dx = X - lp.value[0], dy = Y - lp.value[1];
    float r = sqrt(dx * dx + dy * dy);
    float h = r * lp.value[2];
    Field F = field_at(h);
    float La = abs(F.L);
    Lod lt = lod_for(sqrt(F.var_t), lmax, false);
    Lod lr = lod_for(sqrt(F.var_r + La * La / 18.0), lmax, La >= kMinComet);
    Lod me = mode == 0u ? lt : lr;
    vec3 here = ld3(i);
    // The comet's Jacobian: m(p) = p - D(r) e_r with D the kernel's mean, L / 3.
    float jac = 1.0;
    if (mode == 1u && lp.value[7] != 0.0 && r > 1.0) {
        float Dm = field_at((r - 0.5) * lp.value[2]).L / 3.0;
        float Dp = field_at((r + 0.5) * lp.value[2]).L / 3.0;
        jac = (1.0 - (Dp - Dm)) * (1.0 - (F.L / 3.0) / r);
    }
    if (!me.enabled || me.rho <= 0.0) {
        here *= jac;
        out_data.value[3u * i] = here.x;
        out_data.value[3u * i + 1u] = here.y;
        out_data.value[3u * i + 2u] = here.z;
        return;
    }
    // Each pass's level blurs both axes, so the other pass's is taken out here
    // too; and this pass's kernel is used at rho, so it carries that variance.
    float var = mode == 0u ? F.var_t - lr.rho * lr.vp : F.var_r - lt.rho * lt.vp;
    float sigma = sqrt(max(var / me.rho - me.va, 0.0));
    vec2 er = r > 1e-6 ? vec2(dx, dy) / r : vec2(1.0, 0.0);
    vec2 e = mode == 0u ? vec2(-er.y, er.x) : er;
    vec2 n = vec2(-e.y, e.x);
    float Ls = mode == 1u ? F.L : 0.0;   // signed: > 0 the comet points outward
    float Lp = abs(Ls), sgn = Ls < 0.0 ? -1.0 : 1.0;
    vec3 acc2 = vec3(0.0);
    for (int k = 0; k < 2; ++k) {
        int l = me.l0 + k;
        float wl = k == 0 ? 1.0 - me.frac : me.frac;
        if (wl <= 0.0) continue;
        float T = float(1 << l);
        int I0 = lv.value[3 * l], LH = lv.value[3 * l + 1], LW = lv.value[3 * l + 2];
        // taps on multiples of the spacing, so a symmetric kernel has one at 0
        float smin = -kTruncate * sigma - (sgn < 0.0 ? Lp : 0.0);
        float smax = kTruncate * sigma + (sgn > 0.0 ? Lp : 0.0);
        // a comet's taps no coarser than a sixth of it
        float step = Lp > 0.0 ? min(T, max(Lp / 6.0, 0.125)) : T;
        int k0 = int(floor(smin / step)), k1 = int(ceil(smax / step));
        if (k1 - k0 + 1 > kMaxTaps) {
            step = (smax - smin) / float(kMaxTaps - 1);
            k0 = int(floor(smin / step));
            k1 = int(ceil(smax / step));
        }
        vec3 acc = vec3(0.0);
        float wsum = 0.0;
        float sigc = sqrt(max(sigma * sigma - step * step / 12.0, 0.0));
        for (int t = k0; t <= k1; ++t) {
            float s = float(t) * step;
            float w = Lp > 0.0 ? comet_cell(sgn * s, sigc, Lp, step) : comet_weight(s, sigma, 0.0);
            if (w <= 0.0) continue;
            // Each tap is a pair across the line, +-T/2: a single bilinear tap on
            // the line blurs across it with the pixel's phase.
            float qx = X - s * e.x, qy = Y - s * e.y, o = 0.5 * T * me.q;
            acc += (0.5 * w) * (level_sample_of(l, I0, LH, LW, T, qx + o * n.x, qy + o * n.y) +
                                level_sample_of(l, I0, LH, LW, T, qx - o * n.x, qy - o * n.y));
            wsum += w;
        }
        acc2 += wl * (wsum > 0.0 ? acc / wsum : here);
    }
    acc2 = mix(here, acc2, me.rho) * jac;
    out_data.value[3u * i] = acc2.x;
    out_data.value[3u * i + 1u] = acc2.y;
    out_data.value[3u * i + 2u] = acc2.z;
}
