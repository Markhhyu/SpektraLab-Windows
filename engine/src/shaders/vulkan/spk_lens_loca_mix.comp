#version 450

// spk_lens_loca_mix.comp -- longitudinal CA's scattered light, "mix" half
// (API-SPEC §21.6, macOS 2.x, ported from src/shaders/lens.metal).
//
// out = A - M + B, B = G * M, M recomputed from A. Same p and meta as
// spk_lens_loca_share.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer In { float value[]; } in_data;
layout(set = 0, binding = 1, std430) readonly buffer Blurred { float value[]; } blurred;
layout(set = 0, binding = 2, std430) readonly buffer Params { float value[]; } p;
layout(set = 0, binding = 3, std430) readonly buffer Meta { uint value[]; } meta;
layout(set = 0, binding = 4, std430) writeonly buffer Out { float value[]; } out_data;

uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

float loca_share(vec3 v) {
    float y = 0.25 * v.x + 0.5 * v.y + 0.25 * v.z;
    return (1.0 - p.value[3]) + p.value[3] * smoothstep(p.value[4], 4.0 * p.value[4], y);
}

void main() {
    uint i = spk_global_index();
    if (i >= meta.value[0]) return;
    vec3 va = vec3(in_data.value[3u * i], in_data.value[3u * i + 1u], in_data.value[3u * i + 2u]);
    vec3 vb = vec3(blurred.value[3u * i], blurred.value[3u * i + 1u], blurred.value[3u * i + 2u]);
    vec3 m = vec3(p.value[0], p.value[1], p.value[2]) * loca_share(va) * va;
    vec3 o = va - m + vb;
    out_data.value[3u * i] = o.x;
    out_data.value[3u * i + 1u] = o.y;
    out_data.value[3u * i + 2u] = o.z;
}
