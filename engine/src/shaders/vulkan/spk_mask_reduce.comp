#version 450

// RFC-024's virtual contrast mask, the analysis half. One thread per grid cell;
// the cell partitions the frame so every pixel is counted exactly once. Port of
// `spk_mask_reduce` in src/shaders/contrast_mask.metal.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer Cmy { float value[]; } cmy;
layout(set = 0, binding = 1, std430) readonly buffer Characteristic { float value[]; } characteristic;
layout(set = 0, binding = 2, std430) readonly buffer Base { float value[]; } base_data;
layout(set = 0, binding = 3, std430) readonly buffer Integral { float value[]; } integral_data;
layout(set = 0, binding = 4, std430) readonly buffer Params { float value[]; } params;
layout(set = 0, binding = 5, std430) readonly buffer Meta { uint value[]; } meta;
layout(set = 0, binding = 6, std430) writeonly buffer Grid { float value[]; } grid;

// The floor under `log2`, relative to mid-grey: 2^-20 is ~6 densities below it,
// far under any paper's toe. A numerical guard, not a signal (RFC-024 §5).
const float kMaskLog2Floor = -20.0;

uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

vec3 mask_image_exposure(uint i) {
    float c0 = cmy.value[3u * i];
    float c1 = cmy.value[3u * i + 1u];
    float c2 = cmy.value[3u * i + 2u];
    vec3 accumulated = vec3(0.0);
    uint nl = meta.value[4];
    for (uint l = 0u; l < nl; ++l) {
        float d = c0 * characteristic.value[3u * l]
                + c1 * characteristic.value[3u * l + 1u]
                + c2 * characteristic.value[3u * l + 2u]
                + base_data.value[l];
        float t = exp2(-d * 3.321928094887362);
        accumulated.x += t * integral_data.value[3u * l];
        accumulated.y += t * integral_data.value[3u * l + 1u];
        accumulated.z += t * integral_data.value[3u * l + 2u];
    }
    return vec3(accumulated.x * params.value[0], accumulated.y * params.value[1],
                accumulated.z * params.value[2]);
}

float mask_x(vec3 a) {
    float s = 0.0;
    for (uint c = 0u; c < 3u; ++c) {
        float r = max(a[c] * params.value[3u + c], 0.0);
        s += max(log2(r), kMaskLog2Floor);
    }
    return s * (1.0 / 3.0);
}

void main() {
    uint cell = spk_global_index();
    uint gw = meta.value[2];
    uint gh = meta.value[3];
    if (cell >= gw * gh) return;
    uint W = meta.value[0];
    uint H = meta.value[1];
    uint cy = cell / gw;
    uint cx = cell % gw;
    uint x0 = (cx * W) / gw;
    uint x1 = max(((cx + 1u) * W) / gw, x0 + 1u);
    uint y0 = (cy * H) / gh;
    uint y1 = max(((cy + 1u) * H) / gh, y0 + 1u);
    x1 = min(x1, W);
    y1 = min(y1, H);
    float acc = 0.0;
    for (uint y = y0; y < y1; ++y) {
        for (uint x = x0; x < x1; ++x) {
            acc += mask_x(mask_image_exposure(y * W + x));
        }
    }
    grid.value[cell] = acc / float((x1 - x0) * (y1 - y0));
}
